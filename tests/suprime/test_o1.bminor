// =====================================================
// TEST EXTREMO PARA COMPILADOR B-MINOR
// =====================================================

// ---------- GLOBALS ----------
x : integer = 10;
y : float = 3.14;
flag : boolean = true;
msg : string = "hola";
c : char = 'A';

// array global
nums : array[5] integer = {1,2,3,4,5};

// -----------------------------------------------------
// FUNCIÓN RECURSIVA
// -----------------------------------------------------

factorial : function integer(n: integer) = {

    if(n <= 1){
        return 1;
    }

    return n * factorial(n - 1);
}

// -----------------------------------------------------
// FUNCIÓN CON WHILE
// -----------------------------------------------------

sumatoria : function integer(n: integer) = {

    i : integer = 1;
    s : integer = 0;

    while(i <= n){
        s += i;
        i++;
    }

    return s;
}

// -----------------------------------------------------
// FUNCIÓN CON FOR
// -----------------------------------------------------

potencia : function integer(base: integer, exp: integer) = {

    r : integer = 1;

    for(i: integer = 0; i < exp; i++){
        r *= base;
    }

    return r;
}

// -----------------------------------------------------
// TEST ARRAYS
// -----------------------------------------------------

test_arrays : function void() = {

    i : integer = 0;

    while(i < 5){

        // acceso array
        print nums[i];

        // assignment array
        nums[i] = nums[i] + 10;

        i++;
    }

    print "modificado";

    i = 0;

    while(i < 5){
        print nums[i];
        i++;
    }
}

// -----------------------------------------------------
// TEST OPERADORES
// -----------------------------------------------------

test_ops : function void() = {

    a : integer = 10;
    b : integer = 3;

    print a + b;
    print a - b;
    print a * b;
    print a / b;
    print a % b;

    a += 5;
    print a;

    a -= 2;
    print a;

    a++;
    print a;

    a--;
    print a;

    // comparaciones
    print a == b;
    print a != b;
    print a < b;
    print a > b;
    print a <= b;
    print a >= b;

    // lógica
    print true && false;
    print true || false;
    print !false;
}

// -----------------------------------------------------
// TEST IF / ELSE
// -----------------------------------------------------

test_if : function void() = {

    n : integer = 7;

    if(n % 2 == 0){
        print "par";
    }
    else{
        print "impar";
    }
}

// -----------------------------------------------------
// TEST STRINGS
// -----------------------------------------------------

test_strings : function void() = {

    s : string = "BMinor funcionando";

    print s;
    print "otro string";
}

// -----------------------------------------------------
// TEST SCOPES
// -----------------------------------------------------

test_scope : function void() = {

    x : integer = 100;

    print x;

    {
        x : integer = 200;
        print x;

        {
            x : integer = 300;
            print x;
        }

        print x;
    }

    print x;
}

// -----------------------------------------------------
// TEST FOR COMPLEJO
// -----------------------------------------------------

test_for : function void() = {

    i : integer = 0;
    s : integer = 0;

    for(i = 0; i <= 100; i++){
        s += i;
    }

    print s;
}

// -----------------------------------------------------
// MAIN
// -----------------------------------------------------

main : function void() = {

    print "========== INICIO ==========";

    print factorial(5);

    print sumatoria(100);

    print potencia(2, 10);

    test_arrays();

    test_ops();

    test_if();

    test_strings();

    test_scope();

    test_for();

    print "========== FIN ==========";
}